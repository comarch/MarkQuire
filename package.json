{
  "name": "markquire",
  "version": "0.1.0",
  "description": "Drive-native Markdown editing, rich previews, and anchored review comments for Google Workspace teams",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/comarch/MarkQuire.git"
  },
  "homepage": "https://github.com/comarch/MarkQuire#readme",
  "bugs": {
    "url": "https://github.com/comarch/MarkQuire/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "promptscript:validate": "prs validate --strict",
    "promptscript:compile": "prs compile",
    "promptscript:check": "node scripts/check-promptscript.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:repository": "node scripts/validate-repository.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:companion && npm run build && npm run verify:artifact && npm run verify:repository && npm run promptscript:check",
    "test:companion": "cd companion && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.9",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.3.0",
    "@viz-js/viz": "^3.30.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.4.1",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@promptscript/cli": "^1.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "source-map-js": "1.2.2",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.19",
      "sass": "^1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^3.3.19"
    }
  }
}
